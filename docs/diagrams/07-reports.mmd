%% 7. Reports: which screen reads which data.
%% One row per data path: source → how it is counted → screens.
flowchart TB
  subgraph R1["A · Sales credited to the waiter who served the table"]
    direction LR
    A0[("Order + Payment<br/>settled sales")] --> A1["Paid-sales loader (SQL)<br/>drops reprints, merges<br/>double writes"] --> A2["Re-credit each sale to the<br/>waiter who SERVED the table<br/>(from TicketLog sittings)<br/><i>paidAnalytics.ts</i>"]
    A2 --> A3["Waiter: Today<br/>net · VAT"]
    A2 --> A4["Waiter: top sellers<br/>· sales trends"]
    A2 --> A5["Admin: Review<br/>sales, waiters, voids,<br/>compare periods"]
  end

  subgraph R2["B · All sales, not split by waiter"]
    direction LR
    B0[("Order + Payment")] --> B1["Paid-sales loader (SQL)"] --> B2["Admin: Overview<br/>today's sales · open tables ·<br/>shifts · low stock · print queue"]
  end

  subgraph R3["C · Sales read directly"]
    direction LR
    C0[("Order + Payment")] --> C1["Read rows<br/>for one waiter"]
    C1 --> C2["Waiter: Paid tickets (today)<br/>also uses 'who served' from A"]
    C1 --> C3["Waiter: Print my<br/>day summary"]
    C1 --> C4["Shift summary slip<br/>at clock-out"]
  end

  subgraph R4["D · Open and voided bills"]
    direction LR
    D0[("TicketLog<br/>+ TableOccupancy")] --> D1["Latest bill<br/>per sitting"]
    D1 --> D2["Waiter: Active tickets<br/>(open tables I own)"]
    D1 --> D3["Waiter: Voided<br/>tickets (today)"]
    D1 --> D4["Admin: Tickets per waiter<br/>paid / active / voided / moved<br/>(matched to Order rows)"]
  end

  subgraph R5["E · Shifts and fiskalizimi"]
    direction LR
    E0[("DayShift")] --> E1["Admin: Shifts list"]
    E2[("SyncState<br/>fiscal claims")] --> E3["Admin: Fiskalizimi<br/>to review · deferred ·<br/>corrections"]
  end

  R1 ~~~ R2 ~~~ R3 ~~~ R4 ~~~ R5

  NOTE["Why totals and lists can disagree: today's totals (row A) and the paid list (row C)<br/>use different queries. The paid and voided lists used to turn a failed read into an<br/>empty list ('Paid 0') with no error; they now show the error."]
  R5 ~~~ NOTE

