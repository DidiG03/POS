generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          Int       @id @default(autoincrement())
  displayName String
  role        Role
  pinHash     String
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  orders      Order[]
  externalId  String?   @unique
  shiftsOpened DayShift[] @relation("ShiftOpenedBy")
  shiftsClosed DayShift[] @relation("ShiftClosedBy")
  ticketLogs  TicketLog[]
  notifications Notification[]
  ticketRequestsMade TicketRequest[] @relation("TicketRequestRequester")
  ticketRequestsOwned TicketRequest[] @relation("TicketRequestOwner")
  twoFactorEnabled Boolean  @default(false)
  twoFactorSecret  String?
  /// Optional pay; null means not set.
  salaryAmount     Decimal?
  /// HOURLY | MONTHLY | YEARLY when salaryAmount is set.
  salaryPeriod     String?
  kdsBumpedStations KdsTicketStation[] @relation("KdsBumpedBy")
  reservationsCreated Reservation[] @relation("ReservationCreatedBy")
  saleCorrections SaleCorrection[] @relation("SaleCorrectionActor")
  saleCorrectionsApproved SaleCorrection[] @relation("SaleCorrectionApprover")
}

enum Role {
  ADMIN
  CASHIER
  WAITER
  KP
  CHEF
  HEAD_CHEF
  FOOD_RUNNER
  HOST
  BUSSER
  BARTENDER
  BARBACK
  CLEANER
}

enum PrepStation {
  KITCHEN
  BAR
  DESSERT
}

/// Waiter-facing availability (set from Admin → Menu).
enum MenuStockLevel {
  OK
  LOW
  OUT
}

enum KdsStationStatus {
  NEW
  DONE
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  color     String?
  /// When set, items in this category appear on that KDS screen; null = hidden from KDS.
  kdsStation PrepStation?
  items     MenuItem[]
}

model MenuItem {
  id         Int       @id @default(autoincrement())
  name       String
  sku        String    @unique
  category   Category  @relation(fields: [categoryId], references: [id])
  categoryId Int
  price      Decimal
  vatRate    Decimal
  active     Boolean   @default(true)
  isKg       Boolean   @default(false)
  station    PrepStation @default(KITCHEN)
  /// LOW = yellow warning on waiter menu; OUT = hidden/disabled for ordering.
  stockLevel MenuStockLevel @default(OK)
  /// Remaining units while LOW (decremented on kitchen send). Null = warning-only LOW (legacy).
  stockRemaining Int?
  /// Local calendar day (YYYY-MM-DD) when LOW/OUT was set; before midnight reset applies.
  stockDay       String?
  /// What the store paid per unit (sum of costBreakdown when that is set).
  costPrice      Decimal?
  /// Optional cost split, e.g. [{ "id", "label", "amount" }].
  costBreakdown  Json?
  recipe     RecipeComponent[]
  orderItems OrderItem[]

  @@index([categoryId])
}

model ModifierGroup {
  id       Int        @id @default(autoincrement())
  name     String
  required Boolean    @default(false)
  min      Int        @default(0)
  max      Int        @default(1)
  mods     Modifier[]
}

model Modifier {
  id         Int            @id @default(autoincrement())
  group      ModifierGroup  @relation(fields: [groupId], references: [id])
  groupId    Int
  name       String
  priceDelta Decimal
  sku        String
  active     Boolean        @default(true)
  orderItemModifiers OrderItemModifier[]

  @@index([groupId])
}

model Table {
  id     Int     @id @default(autoincrement())
  label  String
  area   String
  seats  Int     @default(4)
  active Boolean @default(true)
  orders Order[]
}

model Order {
  id        Int        @id @default(autoincrement())
  type      OrderType
  table     Table?     @relation(fields: [tableId], references: [id])
  tableId   Int?
  status    OrderStatus @default(OPEN)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    Int?
  openedAt  DateTime   @default(now())
  closedAt  DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  /// Floor / till location copied off the ticket so reports do not need Table.
  area       String   @default("")
  tableLabel String   @default("")
  covers     Int?
  note       String?
  userName   String?

  /// Same key as the receipt PrintJob so retries cannot double-book a sale.
  idempotencyKey String? @unique
  printJob       PrintJob? @relation(fields: [printJobId], references: [id], onDelete: SetNull)
  printJobId     Int?      @unique

  seatId    String?
  seatLabel String?

  subtotal            Decimal @default(0)
  vatAmount           Decimal @default(0)
  discountAmount      Decimal @default(0)
  discountType        String?
  discountReason      String?
  serviceChargeAmount Decimal @default(0)
  total               Decimal @default(0)
  vatEnabled          Boolean @default(false)

  /// Set when an admin cancels the sale. `status` becomes VOID at the same
  /// time, which is what keeps it out of every report.
  voidedAt DateTime?

  items    OrderItem[]
  payments Payment[]
  corrections SaleCorrection[]

  @@index([userId, closedAt])
  @@index([area, tableLabel, closedAt])
  @@index([closedAt])
  @@index([status, closedAt])
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  OPEN
  PAID
  VOID
}

model OrderItem {
  id         Int       @id @default(autoincrement())
  order      Order     @relation(fields: [orderId], references: [id])
  orderId    Int
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  menuItemId Int?
  sku        String    @default("")
  name       String
  qty        Decimal
  unitPrice  Decimal
  vatRate    Decimal
  note       String?
  station    String?
  categoryName String?
  courseId   String?
  seatId     String?
  sortOrder  Int       @default(0)
  /// Struck off by a corrective invoice. The row stays for audit; reports
  /// and re-issued documents must skip it.
  voidedAt   DateTime?
  mods       OrderItemModifier[]

  @@index([orderId])
  @@index([sku])
  @@index([menuItemId])
}

/**
 * An admin reversal of a settled sale.
 *
 * A fiscalized invoice cannot be withdrawn — the tax service already holds
 * it. It is undone by filing a second document that references the first
 * (CANCEL for the whole invoice, CORRECTIVE for some of its lines), so the
 * two must be kept together: what was reversed, by whom, on whose approval,
 * and which fiscal document settled it. `filedAt` stays null until that
 * document exists, which is what the Fiskalizimi review queue works from.
 */
model SaleCorrection {
  id      Int    @id @default(autoincrement())
  order   Order  @relation(fields: [orderId], references: [id])
  orderId Int
  kind    SaleCorrectionKind
  reason  String

  /// Negative: how much this takes off the original invoice.
  amountDelta Decimal @default(0)
  /// The lines it strikes off. Empty for a whole-invoice cancellation.
  itemsJson   Json?

  actor       User? @relation("SaleCorrectionActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorUserId Int?
  approver    User? @relation("SaleCorrectionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedById Int?

  /// Identifiers of the invoice being corrected.
  originalNslf String?
  originalNivf String?
  /// Identifiers of the corrective document, once it has been filed.
  correctionNslf String?
  correctionNivf String?
  /// Null while the correction still has to be filed with the tax service.
  filedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([orderId])
  @@index([createdAt])
  @@index([filedAt])
}

enum SaleCorrectionKind {
  CANCEL
  CORRECTIVE
}

model OrderItemModifier {
  id         Int       @id @default(autoincrement())
  orderItem  OrderItem @relation(fields: [orderItemId], references: [id])
  orderItemId Int
  modifier   Modifier  @relation(fields: [modifierId], references: [id])
  modifierId Int
  priceDelta Decimal

  @@index([orderItemId])
  @@index([modifierId])
}

model Payment {
  id        Int        @id @default(autoincrement())
  order     Order      @relation(fields: [orderId], references: [id])
  orderId   Int
  method    PaymentMethod
  amount    Decimal
  tip       Decimal    @default(0)
  change    Decimal    @default(0)
  createdAt DateTime   @default(now())
  paidAt    DateTime?
  idempotencyKey String? @unique
  fiscalNslf String?
  fiscalNivf String?
  /// EIC — set only for electronic invoices. Needed because a P9/P10
  /// corrective can only reference an invoice that has one.
  fiscalEic  String?
  metaJson  Json

  @@index([orderId])
  @@index([paidAt])
}

enum PaymentMethod {
  CASH
  CARD
  MIXED
}

model InventoryItem {
  id               Int      @id @default(autoincrement())
  name             String
  sku              String   @unique
  qtyOnHand        Decimal
  lowStockThreshold Decimal @default(0)
  unit             String
  recipeComponents RecipeComponent[]
}

model RecipeComponent {
  id              Int           @id @default(autoincrement())
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id])
  menuItemId      Int
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  inventoryItemId Int
  qtyPerUnit      Decimal

  @@index([menuItemId])
  @@index([inventoryItemId])
}

model DayShift {
  id          Int       @id @default(autoincrement())
  openedAt    DateTime  @default(now())
  closedAt    DateTime?
  openedBy    User      @relation("ShiftOpenedBy", fields: [openedById], references: [id])
  openedById  Int
  closedBy    User?     @relation("ShiftClosedBy", fields: [closedById], references: [id])
  closedById  Int?
  totalsJson  Json

  @@index([closedAt, openedById])
}

model PrintJob {
  id          Int         @id @default(autoincrement())
  type        PrintType
  payloadJson Json
  createdAt   DateTime    @default(now())
  status      PrintStatus @default(QUEUED)

  /// Dedupes client/offline retries (same key → same logical print / payment audit).
  idempotencyKey String? @unique

  // Printer-offline retry queue (PR 3).
  // `attempts` is the number of physical print attempts already made
  // (so the FIRST persisted RETRY row has attempts=1). `nextAttemptAt`
  // is when the printer-station loop should pick it back up.
  // `printerProfileId` records which destination this slip is for, so
  // a multi-printer routed order that only failed at the kitchen
  // doesn't re-print at the bar.
  attempts         Int       @default(0)
  lastError        String?
  nextAttemptAt    DateTime?
  printerProfileId String?

  order Order?

  @@index([status, nextAttemptAt])
}

enum PrintType {
  RECEIPT
  X_REPORT
  Z_REPORT
  TEST
}

enum PrintStatus {
  QUEUED
  RETRY
  SENT
  FAILED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  APPLIED
}

model TicketRequest {
  id          Int            @id @default(autoincrement())
  area        String
  tableLabel  String
  requester   User           @relation("TicketRequestRequester", fields: [requesterId], references: [id])
  requesterId Int
  owner       User           @relation("TicketRequestOwner", fields: [ownerId], references: [id])
  ownerId     Int
  itemsJson   Json
  note        String?
  status      RequestStatus  @default(PENDING)
  createdAt   DateTime       @default(now())
  decidedAt   DateTime?

  @@index([ownerId, status])
  @@index([requesterId])
}


model SyncState {
  key       String   @id
  valueJson Json?
  updatedAt DateTime @updatedAt
}

/// One row per occupied table. Replaces the `tables:open` / `tables:openAt`
/// SyncState JSON maps so concurrent waiters on different tables cannot
/// overwrite each other during a rush.
model TableOccupancy {
  id        Int      @id @default(autoincrement())
  area      String
  label     String
  openedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([area, label])
  @@index([area])
}

model Area {
  id           Int     @id @default(autoincrement())
  name         String  @unique
  sortOrder    Int     @default(0)
  active       Boolean @default(true)
  defaultCount Int     @default(8)
}

model Covers {
  id        Int      @id @default(autoincrement())
  area      String
  label     String
  covers    Int
  createdAt DateTime @default(now())

  @@index([area, label, createdAt])
  @@index([createdAt])
}

model TicketLog {
  id         Int      @id @default(autoincrement())
  user       User     @relation(fields: [userId], references: [id])
  userId     Int
  area       String
  tableLabel String
  covers     Int?
  itemsJson  Json
  note       String?
  /// Dedupes double-submit / retry on table transfer (destination row).
  idempotencyKey String? @unique
  /// Groups the cumulative snapshots of one dining session so reports can
  /// count the newest one instead of every fire. See `latestRowPerSession`.
  sessionKey String?
  createdAt  DateTime @default(now())

  @@index([area, tableLabel, createdAt])
  @@index([sessionKey])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model KdsDayCounter {
  dayKey String @id
  lastNo Int    @default(0)
}

model KdsOrder {
  id        Int      @id @default(autoincrement())
  dayKey    String
  orderNo   Int
  area      String
  tableLabel String
  openedAt  DateTime @default(now())
  closedAt  DateTime?

  tickets   KdsTicket[]

  @@unique([dayKey, orderNo])
  @@index([area, tableLabel, closedAt])
}

model KdsTicket {
  id        Int      @id @default(autoincrement())
  order     KdsOrder @relation(fields: [orderId], references: [id])
  orderId   Int
  userId    Int?
  firedAt   DateTime @default(now())
  itemsJson Json
  note      String?

  stations  KdsTicketStation[]

  @@index([orderId, firedAt])
}

model KdsTicketStation {
  id         Int             @id @default(autoincrement())
  ticket     KdsTicket       @relation(fields: [ticketId], references: [id])
  ticketId   Int
  station    PrepStation
  status     KdsStationStatus @default(NEW)
  bumpedAt   DateTime?
  bumpedBy   User?           @relation("KdsBumpedBy", fields: [bumpedById], references: [id])
  bumpedById Int?

  @@unique([ticketId, station])
  @@index([station, status, bumpedAt])
}


enum NotificationType {
  SECURITY
  OTHER
}

model Notification {
  id         Int               @id @default(autoincrement())
  user       User              @relation(fields: [userId], references: [id])
  userId     Int
  type       NotificationType  @default(SECURITY)
  message    String
  readAt     DateTime?
  createdAt  DateTime          @default(now())

  @@index([userId, readAt, createdAt])
  @@index([createdAt])
}

enum ReservationStatus {
  BOOKED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Reservation {
  id            Int               @id @default(autoincrement())
  area          String
  tableLabel    String?
  customerName  String
  customerPhone String?
  partySize     Int               @default(2)
  startsAt      DateTime
  /** When the party actually sat. Null while still BOOKED. */
  seatedAt      DateTime?
  durationMin   Int               @default(120)
  note          String?
  status        ReservationStatus @default(BOOKED)
  createdBy     User              @relation("ReservationCreatedBy", fields: [createdById], references: [id])
  createdById   Int
  /** External sync source (e.g. GOOGLE_CALENDAR). */
  externalSource String?
  /** Stable id from the external system (e.g. calendar event UID). */
  externalId     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([startsAt])
  @@index([area, tableLabel, startsAt])
  @@unique([externalSource, externalId])
}


