{
  "name": "code-orbit-pos",
  "version": "0.2.7",
  "private": true,
  "description": "Desktop POS for  Code Orbit Agroturizem (Electron + React + Prisma)",
  "type": "module",
  "main": "dist/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev --entry dist/main/index.js",
    "dev:kds": "electron-vite dev --config electron.vite.kds.config.ts --entry dist/kds/main/index.js",
    "build": "electron-vite build",
    "build:kds": "electron-vite build --config electron.vite.kds.config.ts",
    "prisma:prepare-electron": "node scripts/preparePrismaForElectron.mjs",
    "db:seedfile": "node scripts/buildSeedDb.mjs",
    "dist": "pnpm build && pnpm db:generate && pnpm prisma:prepare-electron && electron-builder",
    "dist:dir": "pnpm build && pnpm db:generate && pnpm prisma:prepare-electron && electron-builder --dir",
    "dist:kds": "pnpm build:kds && electron-builder --config electron-builder.kds.yml -mwl",
    "dist:kds:dir": "pnpm build:kds && electron-builder --config electron-builder.kds.yml --dir",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=20",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run --passWithNoTests --exclude \"tests/**\"",
    "test:ui": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "tsx scripts/seed.ts",
    "db:wipe": "tsx scripts/wipeLocalDb.ts",
    "db:clean-today": "tsx scripts/cleanTodayTicketData.ts",
    "db:check-parity": "tsx scripts/checkSchemaParity.ts",
    "serial:rebuild": "node scripts/rebuildSerialport.mjs",
    "dev:mobile": "vite --config vite.mobile.config.ts",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "cap:sync": "pnpm build:mobile && cap sync",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "cap:run:ios": "pnpm cap:sync && cap run ios",
    "cap:run:android": "pnpm cap:sync && cap run android",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=18.17.0",
    "pnpm": ">=8"
  },
  "build": {
    "appId": "com.codeorbit.pos",
    "productName": "Code Orbit POS",
    "directories": {
      "buildResources": "build-resources"
    },
    "icon": "build-resources/icon.png",
    "asarUnpack": [
      "node_modules/.prisma/**",
      "**/node_modules/.prisma/**",
      "**/.prisma/**",
      "**/@prisma/**"
    ],
    "files": [
      "dist/**",
      "node_modules/**",
      "node_modules/.prisma/**",
      "build-resources/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/.prisma",
        "to": "app.asar.unpacked/node_modules/.prisma"
      },
      {
        "from": "build-resources/seed.db",
        "to": "seed.db"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business",
      "icon": "build-resources/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build-resources/icon.ico"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "installerIcon": "build-resources/icon.ico",
      "uninstallerIcon": "build-resources/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "DidiG03",
      "repo": "POS"
    }
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx,json,css,md}": [
      "pnpm lint",
      "prettier --write"
    ]
  },
  "pnpm": {
    "allowedBuiltDependencies": [
      "@prisma/engines",
      "@prisma/client",
      "prisma",
      "@serialport/bindings-cpp",
      "electron",
      "esbuild"
    ],
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "@tailwindcss/oxide",
      "@serialport/bindings-cpp",
      "electron",
      "esbuild",
      "prisma"
    ]
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.1",
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.54.2",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "electron": "^37.2.6",
    "electron-builder": "^26.7.0",
    "electron-vite": "^4.0.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prisma": "^6.13.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.1",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748",
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@prisma/client": "^6.13.0",
    "@sentry/electron": "^7.6.0",
    "bcryptjs": "^3.0.2",
    "bonjour-service": "^1.3.0",
    "dotenv": "^17.2.1",
    "electron-updater": "^6.6.2",
    "i18next": "^26.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.0.7",
    "react-router-dom": "^7.8.0",
    "serialport": "^13.0.0",
    "zod": "^4.0.16",
    "zustand": "^5.0.7"
  }
}
